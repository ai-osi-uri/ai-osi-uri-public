<?xml version="1.0" encoding="UTF-8"?>
<!--
    PLACEHOLDER FILE.

    The real GoogleService-Info-Dev.plist is generated by
    `mobile-firebase-setup` (or downloaded from Firebase Console) and
    stored ONLY on the developer machine + as a GitHub Actions secret
    (`GOOGLE_SERVICE_INFO_PLIST_DEV_B64`).

    Do NOT commit real Firebase credentials to git. See .gitignore.

    In CI, the workflow decodes the secret into
    `apps/ios/MyApp/Resources/GoogleService-Info-Dev.plist`
    before `xcodebuild archive`.
-->
<plist version="1.0">
<dict>
    <key>PROJECT_ID</key>
    <string>REPLACE_WITH_REAL_FIREBASE_PROJECT_ID</string>
    <key>BUNDLE_ID</key>
    <string>com.example.myapp.dev</string>
</dict>
</plist>
