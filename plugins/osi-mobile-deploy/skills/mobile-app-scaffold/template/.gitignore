# ---------- iOS ----------
apps/ios/build/
apps/ios/DerivedData/
apps/ios/*.xcworkspace/xcuserdata/
apps/ios/**/xcuserdata/
apps/ios/**/*.xcuserstate

# Xcode project (regenerated by xcodegen)
apps/ios/*.xcodeproj

# Secrets
apps/ios/**/GoogleService-Info*.plist
!apps/ios/**/GoogleService-Info*.plist.sample

# ---------- Android ----------
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties
apps/android/keystore.properties
apps/android/**/*.keystore
apps/android/**/*.jks
apps/android/app/google-services.json
apps/android/app/src/*/google-services.json
!apps/android/**/*.sample

# ---------- Fastlane ----------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/README.md

# ---------- Ruby ----------
.bundle/
vendor/bundle/

# ---------- Editor / OS ----------
.DS_Store
.idea/
*.iml
.vscode/
