<?xml version="1.0" encoding="UTF-8"?>
<!-- 共通発音辞書（全案件で適用）。旧 narration-rules v1 の知見を alias に移植。
     会社固有の社名・製品名・人名は dict-{会社}.pls 側に書く。 -->
<lexicon version="1.0"
         xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
         alphabet="ipa" xml:lang="ja-JP">

  <!-- 英略語：アルファベット読み化の回避（かな音写） -->
  <lexeme><grapheme>AI</grapheme><alias>えーあい</alias></lexeme>
  <lexeme><grapheme>ISO</grapheme><alias>あいえすおー</alias></lexeme>
  <lexeme><grapheme>SaaS</grapheme><alias>サース</alias></lexeme>
  <lexeme><grapheme>HR</grapheme><alias>えいちあーる</alias></lexeme>
  <lexeme><grapheme>IR</grapheme><alias>あいあーる</alias></lexeme>
  <lexeme><grapheme>API</grapheme><alias>えーぴーあい</alias></lexeme>

  <!-- 複数読み漢字：v3クローン/ネイティブが誤判定しがちな語 -->
  <lexeme><grapheme>見える化</grapheme><alias>みえるか</alias></lexeme>
  <lexeme><grapheme>最大級</grapheme><alias>さいだいきゅう</alias></lexeme>
  <lexeme><grapheme>蓄え</grapheme><alias>たくわえ</alias></lexeme>
  <lexeme><grapheme>情報開示</grapheme><alias>じょうほうかいじ</alias></lexeme>
  <lexeme><grapheme>行き交う</grapheme><alias>いきかう</alias></lexeme>

</lexicon>
